{
  "name": "clipmer",
  "version": "3.6.3",
  "description": "Secrets-aware clipboard manager for Linux",
  "author": {
    "name": "Mustafa",
    "email": "mustafa@clipmer.local"
  },
  "homepage": "https://github.com/0x99M/clipmer",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "CLIPMER_PROFILE=dev electron . --no-sandbox",
    "build": "electron-builder --linux deb rpm && node build/build-appimage.js --linux AppImage",
    "build:dev": "node build/build-appimage.js --linux --config build/dev-build.js"
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.clipmer.app",
    "productName": "Clipmer",
    "files": [
      "**/*",
      "!assets/make-icons.py"
    ],
    "toolsets": {
      "appimage": "1.0.2"
    },
    "afterPack": "build/appimage-apprun.js",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icons/",
      "category": "Utility",
      "extraFiles": [
        {
          "from": "build/app.clipmer.Clipmer.appdata.xml",
          "to": "usr/share/metainfo/app.clipmer.Clipmer.appdata.xml"
        },
        {
          "from": "build/clipmer.desktop",
          "to": "usr/share/applications/clipmer.desktop"
        }
      ]
    },
    "deb": {
      "depends": [
        "at-spi2-core"
      ],
      "afterInstall": "build/postinst.sh",
      "afterRemove": "build/afterRemove.sh"
    },
    "rpm": {
      "depends": [
        "at-spi2-core"
      ],
      "afterInstall": "build/postinst.sh",
      "afterRemove": "build/afterRemove.sh"
    }
  }
}
